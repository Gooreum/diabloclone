+bool KeymapperOptions::SetActionKey(std::string_view actionId, std::string_view keyName)
+{
+	for (Action &action : actions) {
+		if (action.key != actionId) continue;
+		if (keyName.empty()) return action.SetValue(SDLK_UNKNOWN);
+		const auto it = keyNameToKeyID.find(keyName);
+		if (it == keyNameToKeyID.end()) return false;
+		return action.SetValue(static_cast<int>(it->second));
+	}
+	return false;
+}
