+		for (const char c : s) {
+			if (c == '"' || c == '\\') out += '\\';
+			if (static_cast<unsigned char>(c) >= 0x20) out += c;
+		}
+		return out + "\"";
+	};
+	std::string json = "[";
+	for (const Action &action : actions) {
+		if (json.size() > 1) json += ',';
+		json += StrCat("{\"id\":", quote(action.key), ",\"name\":", quote(action.GetName()), ",\"key\":", quote(action.GetValueDescription()), "}");
+	}
+	return json + "]";
+}
